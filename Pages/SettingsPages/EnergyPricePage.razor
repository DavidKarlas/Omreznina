@using Omreznina.Components
@using Omreznina.Client.Logic
@using Omreznina.Logic
@inject ViewModel ViewModel

<div class="d-flex flex-column  mt-3 justify-content-center align-items-center">
    <h1>Cena eletrične energije</h1>
@*     <span>Ali želite v izračun vkjučiti tudi ceno električne energije?</span>
    <YesNoRadioButtonComponent NoText="Ne"
                               YesText="Da"
                               @bind-Value="calculationOptions.IncludeEnergyPrice" /> *@
    @if (calculationOptions.IncludeEnergyPrice)
    {
        @if (calculationOptions.TwoTariffSystem)
        {
            <span>Cena višje tarife(brez DDV):</span>
            <InputNumber step="0.001" @bind-Value="calculationOptions.HighTariffEnergyPrice" />
            <span>Cena nižje tarife(brez DDV):</span>
            <InputNumber step="0.001" @bind-Value="calculationOptions.LowTariffEnergyPrice" />
        }
        else
        {
            <span>Cena enotne tarife(brez DDV):</span>
            <InputNumber step="0.001" @bind-Value="calculationOptions.SingleTariffEnergyPrice" />
        }
    }
    <NavigationButtonsComponent />
</div>

@code {
    [Parameter]
    public bool IsLeftSide { get; set; }

    private CalculationOptions calculationOptions;
    protected override void OnInitialized()
    {
        if (IsLeftSide)
            calculationOptions = ViewModel.LeftCalculationOptions;
        else
            calculationOptions = ViewModel.RightCalculationOptions;
        base.OnInitialized();
    }
}